amends "package://github.com/jdx/hk/releases/download/v2.7.1/hk@2.7.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.7.1/hk@2.7.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// ツールとタスクは mise.toml が正。ここでは、変更したファイルに応じて mise のタスクを呼ぶ。
// pre-commit の対象はステージされたファイルだけで、glob に一致しないステップは動かない。
// リポジトリ全体の点検は mise run check で行う。hk 経由にするなら hk check --all を使う
// (hk run pre-commit や hk check は、ステージ前の変更やクリーンな状態では何も点検しない)。
// ruff と ty は dev 依存に入れ、版は uv.lock で固定する。prefix で uv run --locked を前に付ける。
local python = new Group {
    prefix = List("uv", "run", "--locked", "--")
    steps {
        ["ruff"] = Builtins.ruff
        // Group の子ステップは並行して走りうるので、ruff の fix の後に整形する
        ["ruff-format"] = (Builtins.ruff_format) {
            depends = "ruff"
        }
        ["ty"] = (Builtins.ty) {
            // {{files}} を外し、.py / .pyi が変わったときにプロジェクト全体を検査する
            check = new CommandSpec {
                command = new Command { argv = List("ty", "check") }
                effect = "read"
            }
        }
    }
}

local linters = new Mapping {
    ["python"] = python
    ["jactionlint"] = Builtins.jactionlint
    ["validate"] = new Step {
        glob = List(".claude-plugin/**", "plugins/**")
        check = "mise run validate"
    }
    ["agents-sync"] = new Step {
        glob = List("AGENTS.md", ".github/copilot-instructions.md")
        check = "mise run agents-sync:check"
    }
    ["policy"] = new Step {
        glob = List(".claude-plugin/marketplace.json", "plugins/*/.claude-plugin/plugin.json")
        check = "mise run policy:check"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    // pytest は、コミットごとに走らせるには遅いことが多いので、push の前に走らせる。
    ["pre-push"] {
        steps {
            ["test"] { check = "mise run test" }
        }
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    // コミットメッセージに AI ツールの帰属行(Co-Authored-By など)を入れない。
    ["commit-msg"] {
        steps {
            ["no-ai-attribution"] = new Step {
                check = "mise run commit-msg:check -- {{commit_msg_file}}"
            }
        }
    }
}
